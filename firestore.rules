rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: Publicly viewable catalogue, writable by store management
    // Permanently block legacy demo sample products from ever being created or recreated
    match /products/{productId} {
      allow read: if true;
      allow create, update: if !(productId in ['ns-01', 'ns-02', 'ns-03', 'ns-04', 'ns-05', 'ns-06', 'ns-07', 'ns-08', 'ns-09', 'ns-10', 'ns-11', 'ns-12']);
      allow delete: if true;
    }

    // Orders: Any customer can place an order; store management can view and update status
    // Block demo orders from being recreated
    match /orders/{orderId} {
      allow create, update: if !(orderId in ['NS-1045', 'NS-1046', 'NS-1047']);
      allow read: if true;
      allow delete: if true;
    }

    // Store Settings: Publicly viewable, updateable by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer Messages: Any visitor can send a message
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Customer Reviews: Any customer can view and write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
