# Email Server / SMTP Settings for Automated Order Notifications
# You can use standard Gmail App Password, Resend, SendGrid, or any custom SMTP provider.

# Provider option 1: Gmail SMTP (e.g. yourstore@gmail.com with Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="naarirshopno.official@gmail.com"
SMTP_PASS="your_16_digit_app_password_here"

# Provider option 2: Custom / Transactional SMTP (e.g. Resend, Brevo, SendGrid)
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxxxxxxxxxxx"

# Sender info displayed to customers
FROM_NAME="নারীর স্বপ্ন (Naarir Shopno)"
FROM_EMAIL="support@naarirshopno.com"

# Admin notification email to receive instant CC of every new order
ADMIN_NOTIFICATION_EMAIL="AliIslam01911@gmail.com"

# Storefront base URL for order tracking links
APP_URL="https://ais-dev-oweeiycfzl44oipck75o7h-256765997112.asia-southeast1.run.app"
